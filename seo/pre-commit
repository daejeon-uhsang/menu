#!/bin/sh
# menu.json 유효성 검사 — 커밋 전 자동 실행

# 이번 커밋에 menu.json이 포함되어 있는지 확인
if git diff --cached --name-only | grep -q "^menu\.json$"; then

  echo "🔍 menu.json 유효성 검사 중..."

  # 스테이징된 menu.json 내용을 임시 파일로 추출해서 검사
  TMPFILE=$(mktemp /tmp/menu_check.XXXXXX.json)
  git show :menu.json > "$TMPFILE"

  # Python으로 JSON 파싱 검증
  python3 -c "
import json, sys

with open('$TMPFILE') as f:
    try:
        data = json.load(f)
    except json.JSONDecodeError as e:
        print(f'❌ JSON 오류: {e}')
        sys.exit(1)

# 필수 구조 확인
if 'sections' not in data:
    print('❌ sections 키가 없습니다')
    sys.exit(1)

# ID 중복 검사
ids = []
dupes = []
for sec in data['sections']:
    for item in sec.get('items', []):
        iid = item.get('id', '')
        if iid in ids:
            dupes.append(iid)
        ids.append(iid)

if dupes:
    print(f'❌ 중복된 item ID 발견: {dupes}')
    sys.exit(1)

# 필수 필드 누락 검사
errors = []
for sec in data['sections']:
    for item in sec.get('items', []):
        if not item.get('id'):
            errors.append(f'{sec[\"title\"]} 섹션에 id 없는 항목 있음')
        if not item.get('name'):
            errors.append(f'{sec[\"title\"]} 섹션에 name 없는 항목 있음')
        if not item.get('priceBottle') and not item.get('priceGlass'):
            pass  # 가격 없는 항목도 허용 (옵션)

if errors:
    for e in errors:
        print(f'⚠️  {e}')
    sys.exit(1)

total = sum(len(s.get('items',[])) for s in data['sections'])
print(f'✅ 검사 통과 — 섹션 {len(data[\"sections\"])}개, 메뉴 {total}개, ID 중복 없음')
"

  STATUS=$?
  rm -f "$TMPFILE"

  if [ $STATUS -ne 0 ]; then
    echo ""
    echo "💥 커밋이 중단됐습니다. menu.json을 수정 후 다시 시도하세요."
    exit 1
  fi

fi

# 검색엔진·AI용 정적 텍스트 자동 갱신 (실패해도 커밋은 막지 않음)
if git diff --cached --name-only | grep -qE "^(menu\.json|index\.html|seo/)"; then
  if ! git diff --quiet -- index.html llms.txt sitemap.xml faq.html 2>/dev/null; then
    echo "⚠️  index.html/llms.txt/sitemap.xml 에 스테이징 안 된 변경이 있어 SEO 갱신을 건너뜁니다"
  else
    TMPM=$(mktemp /tmp/menu_seo.XXXXXX.json); git show :menu.json > "$TMPM"
    if python3 seo/build_seo.py "$TMPM"; then
      git add index.html llms.txt sitemap.xml faq.html
    else
      echo "⚠️  SEO 갱신 실패 — 메뉴 배포는 그대로 진행합니다 (나중에 python3 seo/build_seo.py 로 재실행)"
    fi
    rm -f "$TMPM"
  fi
fi

exit 0
